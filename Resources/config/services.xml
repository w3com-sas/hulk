<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="w3com_hulk.service.display_provider"
                 class="W3com\HulkBundle\Service\DisplayProvider" public="true">
            <argument>%hulk.config%</argument>
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager"/>
            <argument type="service" id="router"/>
            <argument type="service" id="w3com_hulk.filter.filter_session_manager"/>
        </service>

        <service id="w3com_hulk.service.display_filter_provider"
                 class="W3com\HulkBundle\Service\DisplayFilterProvider" public="true">
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager"/>
            <argument>%hulk.config%</argument>
        </service>

        <service id="w3com_hulk.filter.filter_session_manager" class="W3com\HulkBundle\Filter\FilterSessionManager">
            <argument type="service" id="session" />
            <argument type="service" id="request_stack"/>
        </service>
        <service id="w3com_hulk.menu.menu_builder"
                 class="W3com\HulkBundle\Menu\MenuBuilder">
            <argument type="service" id="knp_menu.factory"/>
            <argument type="service" id="w3com_hulk.menu.menu_session"/>
            <tag name="knp_menu.menu_builder" method="createMainMenu" alias="main"/>
        </service>
        <service id="w3com_hulk.menu.menu_session" class="W3com\HulkBundle\Menu\MenuSession">
            <argument type="service" id="request_stack" />
            <argument type="service" id="session"/>
        </service>
        <service id="w3com_hulk.service.search_view_provider" class="W3com\HulkBundle\Service\SearchViewProvider">
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager" />
            <argument type="service" id="request_stack"/>
        </service>
    </services>
</container>