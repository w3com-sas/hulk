<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="w3com_hulk.service.display_provider"
                 class="W3com\HulkBundle\Service\DisplayProvider" public="true">
            <argument>%hulk.config%</argument>
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager"/>
            <argument type="service" id="W3com\BoomBundle\Service\BoomGenerator"/>
            <argument type="service" id="router"/>
            <argument type="service" id="w3com_hulk.filter.filter_session_manager"/>
            <argument type="service" id="monolog.logger"/>
            <argument type="service" id="W3com\HulkBundle\Util\DisplayConstructor"/>
        </service>

        <service class="W3com\HulkBundle\Url\UrlManager" id="w3com_hulk.url.url_manager">
            <argument type="service" id="router.default"/>
            <argument type="service" id="monolog.logger"/>
        </service>

        <service id="w3com_hulk.service.display_form_provider"
                 class="W3com\HulkBundle\Service\DisplayFormProvider" public="true">
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager"/>
            <argument type="service" id="W3com\BoomBundle\Service\BoomGenerator"/>
            <argument type="service" id="w3com_hulk.url.url_manager"/>
            <argument type="service" id="W3com\HulkBundle\Util\DisplayConstructor"/>
            <argument>%hulk.config%</argument>
        </service>

        <service id="w3com_hulk.filter.filter_session_manager" class="W3com\HulkBundle\Filter\FilterSessionManager">
            <argument type="service" id="session" />
            <argument type="service" id="request_stack"/>
        </service>
        <service id="w3com_hulk.menu.menu_builder"
                 class="W3com\HulkBundle\Menu\MenuBuilder">
            <argument type="service" id="knp_menu.factory"/>
            <argument type="service" id="w3com_hulk.menu.menu_session"/>
            <tag name="knp_menu.menu_builder" method="createMainMenu" alias="main"/>
        </service>
        <service id="w3com_hulk.menu.menu_session" class="W3com\HulkBundle\Menu\MenuSession" public="true">
            <argument type="service" id="request_stack" />
            <argument type="service" id="session"/>
        </service>
        <service id="w3com_hulk.service.search_view_provider" class="W3com\HulkBundle\Service\SearchViewProvider">
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager" />
            <argument type="service" id="request_stack"/>
        </service>
        <service id="w3com_hulk.finder.json_finder" class="W3com\HulkBundle\Finder\JsonFinder">
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager" />
            <argument>%hulk.config%</argument>
        </service>
        <service class="W3com\HulkBundle\Service\DisplayPersister" id="w3com_hulk.service.display_persister">
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="monolog.logger"/>
            <argument type="service" id="W3com\BoomBundle\Service\BoomGenerator"/>
        </service>
        <service class="W3com\HulkBundle\Service\CsvManager" id="w3com_hulk.service.csv_manager">
            <argument type="service" id="w3com_hulk.service.display_provider"/>
            <argument type="service" id="request_stack"/>
        </service>
        <service class="W3com\HulkBundle\Util\DisplayConstructor" id="W3com\HulkBundle\Util\DisplayConstructor">
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager"/>
            <argument type="service" id="W3com\BoomBundle\Service\BoomGenerator"/>
            <argument type="service" id="router"/>
            <argument type="service" id="monolog.logger"/>
        </service>
    </services>
</container>