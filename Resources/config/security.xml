<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">


    <services>
        <service id="w3com_hulk.security.login_form_authenticator" class="W3com\HulkBundle\Security\LoginFormAuthenticator">
            <argument type="service" id="security.user.provider.concrete.in_memory"/>
            <argument type="service" id="router.default"/>
            <argument type="service" id="security.csrf.token_manager"/>
            <argument type="service" id="security.user_password_encoder.generic"/>
        </service>
    </services>

</container>