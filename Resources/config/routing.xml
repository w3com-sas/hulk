<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">
    <route id="w3com_create_view" path="/create-view/{filename}" methods="GET">
        <default key="_controller">w3com_hulk.controller.create_view_controller::createView</default>
    </route>
    <route id="w3com_display" path="/display/{filename}" methods="GET POST">
        <default key="_controller">w3com_hulk.controller.display_controller::display</default>
    </route>
    <route id="w3com_display_admin" path="/admin/display/{filename}" methods="GET">
        <default key="_controller">w3com_hulk.controller.display_controller::debug</default>
    </route>
    <route id="w3com_save_filters" path="/save-filters" methods="POST">
        <default key="_controller">w3com_hulk.controller.save_filters_controller::saveFilters</default>
    </route>
    <route id="w3com_search_view" path="/search-view" methods="POST">
        <default key="_controller">w3com_hulk.controller.search_view_controller::searchView</default>
    </route>
    <route id="w3com_update_project_entity" path="/update-view/{filename}" methods="GET">
        <default key="_controller">w3com_hulk.controller.update_project_entity_controller::updateView</default>
    </route>
    <route id="w3com_update_sap" path="/update-entity" methods="POST">
        <default key="_controller">w3com_hulk.controller.update_sap_controller::updateSap</default>
    </route>
    <route id="w3com_api_request" path="/api-request" methods="POST">
        <default key="_controller">w3com_hulk.controller.api_request_controller::apiRequest</default>
    </route>
    <route id="w3com_display_filters" path="/display-filters/{filename}" methods="GET">
        <default key="_controller">w3com_hulk.controller.display_filters_controller::filtersForm</default>
    </route>
</routes>