<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="w3com_hulk.twig.search_view_extension" class="W3com\HulkBundle\Twig\SearchViewExtension">
            <tag name="twig.extension"/>
            <argument type="service" id="twig" />
        </service>
        <service id="w3com_hulk.twig.display_html_extension" class="W3com\HulkBundle\Twig\DisplayHtmlExtension">
            <tag name="twig.extension"/>
            <argument type="service" id="twig" />
        </service>
        <service id="w3com_hulk.twig.display_js_extension" class="W3com\HulkBundle\Twig\DisplayJsExtension">
            <tag name="twig.extension"/>
            <argument type="service" id="twig" />
        </service>
    </services>
</container>