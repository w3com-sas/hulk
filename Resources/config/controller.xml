<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="w3com_hulk.controller.app_controller"
                 class="W3com\HulkBundle\Controller\AppController" public="true">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="monolog.logger"/>
            <argument type="service" id="w3com_hulk.finder.json_finder"/>
            <argument type="service" id="w3com_hulk.service.display_provider"/>
            <argument type="service" id="w3com_hulk.service.display_form_provider"/>
            <argument type="service" id="w3com_hulk.url.url_manager"/>
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
        <service id="w3com_hulk.controller.display_controller"
                 class="W3com\HulkBundle\Controller\DisplayController" public="true">
            <argument type="service" id="w3com_hulk.service.display_provider"/>
            <argument type="service" id="monolog.logger"/>
            <argument type="service" id="request_stack"/>
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
        <service id="w3com_hulk.controller.display_form_controller"
                 class="W3com\HulkBundle\Controller\DisplayFormController" public="true">
            <argument type="service" id="w3com_hulk.service.display_form_provider"/>
            <argument type="service" id="request_stack"/>
            <argument
                    type="service" id="w3com_hulk.url.url_manager"/>
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
        <service id="w3com_hulk.controller.filter_controller"
                 class="W3com\HulkBundle\Controller\FilterController" public="true">
            <argument type="service" id="session"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="monolog.logger"/>
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
        <service id="w3com_hulk.controller.search_view_controller"
                 class="W3com\HulkBundle\Controller\SearchViewController" public="true">
            <argument type="service" id="w3com_hulk.service.search_view_provider"/>
            <argument type="service" id="request_stack"/>
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
        <service id="w3com_hulk.controller.update_project_entity_controller"
                 class="W3com\HulkBundle\Controller\UpdateProjectEntityController" public="true">
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
        <service id="w3com_hulk.controller.update_sap_controller"
                 class="W3com\HulkBundle\Controller\UpdateSapController" public="true">
            <argument type="service" id="monolog.logger"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="w3com_hulk.service.display_persister"/>
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
        <service id="w3com_hulk.controller.api_request_controller"
                 class="W3com\HulkBundle\Controller\ApiRequestController" public="true">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="monolog.logger"/>
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
        <service id="w3com_hulk.controller.export_csv_controller"
                 class="W3com\HulkBundle\Controller\ExportCsvController" public="true">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="w3com_hulk.service.csv_manager"/>
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
    </services>

</container>