<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="w3com_hulk.service.table_provider"
                 class="W3com\HulkBundle\Service\TableProvider">
            <argument>%hulk.config%</argument>
            <argument type="service" id="W3com\BoomBundle\Service\BoomManager"/>
            <argument type="service" id="router"/>
            <argument type="service" id="w3com_hulk.filter.filter_session_manager"/>
        </service>
    </services>
</container>