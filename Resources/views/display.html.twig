{% extends '@W3comHulk/base.html.twig' %}
{% block content %}

    {% if table.error.fileExist %}

        {# Warning message #}
        {% include '@W3comHulk/error/missing_fields.html.twig' %}

        {% include '@W3comHulk/include/header.html.twig' %}

        {# Html table #}
        {% include '@W3comHulk/table/table.html.twig' %}

        {# CellAction template #}
        {% include '@W3comHulk/action/cell_action.html.twig' %}

    {% else %}

        {% include '@W3comHulk/error/missing_file.html.twig' %}

    {% endif %}

    {% include '@W3comHulk/include/modal.html.twig' %}

    {% include '@W3comHulk/include/template.html.twig' %}

{% endblock %}

{% block javascripts %}
    <script>

        const hulkUrls = {
            updateEntity: '{{ path('w3com_update_entity') }}'
        };

        $.fn.dataTable.ext.search.push(
            function (settings, data) {

                {# Trie les data à chaque "draw()" du tableau #}
                {# data = ligne du tableau #}
                {% for filter in table.filters if filter.active == 'Y' and (filter.type == 'multiple'
                    or filter.type == 'multiple-date') %}

                window['minId{{ filter.fieldName }}'] = '#min' + '{{ filter.fieldName }}';
                window['maxId{{ filter.fieldName }}'] = '#max' + '{{ filter.fieldName }}';

                {% if filter.type == 'multiple' and filter.active == 'Y' %}

                var minVal = parseInt($(window['minId{{ filter.fieldName }}']).val(), 10);
                var maxVal = parseInt($(window['maxId{{ filter.fieldName }}']).val(), 10);
                var dataToCompare = parseInt(data[{{ filter.index }}], 10);

                {% elseif filter.type == 'multiple-date' and filter.active == 'Y' %}

                var minVal = parseInt(new Date($(window['minId{{ filter.fieldName }}']).val()).getTime());
                var maxVal = parseInt(new Date($(window['maxId{{ filter.fieldName }}']).val()).getTime());
                var dataToCompare = parseInt(new Date(data[{{ filter.index }}]).getTime());

                {% endif %}


                // Si les champs ne sont pas remplis osef
                if (!isNaN(minVal) && !isNaN(maxVal)) {

                    // Si la data est vide on l'exclu
                    if (!isNaN(dataToCompare)) {
                        // Si la data n'est pas dans l'interval on l'exclu
                        if (dataToCompare < minVal || dataToCompare > maxVal) {
                            return false;
                        }
                    } else {
                        return false;
                    }

                }

                {% endfor %}

                return true;

            }
        );


        $(document).ready(function () {
            var data = [
                {% for object in table.data %}

                {
                    {% for col, value in object %}

                    '{{ col }}': '{{ value }}',

                    {% endfor %}
                },
                {% endfor %}
            ];
            var table = $('#dataTable').DataTable({
                language: {
                    processing: "Traitement en cours...",
                    search: "Rechercher&nbsp;:",
                    lengthMenu: "Afficher _MENU_ &eacute;l&eacute;ments",
                    info: "Affichage de l'&eacute;lement _START_ &agrave; _END_ sur _TOTAL_ &eacute;l&eacute;ments",
                    infoEmpty: "Affichage de l'&eacute;lement 0 &agrave; 0 sur 0 &eacute;l&eacute;ments",
                    infoFiltered: "(filtr&eacute; de _MAX_ &eacute;l&eacute;ments au total)",
                    infoPostFix: "",
                    loadingRecords: "Chargement en cours...",
                    zeroRecords: "Aucun &eacute;l&eacute;ment &agrave; afficher",
                    emptyTable: "Aucune donnée disponible dans le tableau",
                    paginate: {
                        first: "Premier",
                        previous: "Pr&eacute;c&eacute;dent",
                        next: "Suivant",
                        last: "Dernier"
                    },
                    aria: {
                        sortAscending: ": activer pour trier la colonne par ordre croissant",
                        sortDescending: ": activer pour trier la colonne par ordre décroissant"
                    }
                },
                dom: 'tp',
                {% if table.pageLenght != null %}
                pageLength: {{ table.pageLenght }},
                {% else %}
                pageLength: 10,
                {% endif %}
                data: data,
                //   order: [[3, "asc"]],
                columns: [

                    {% for column in table.columns if column.active == 'Y' %}

                    {% if column.type == 'text' or column.hidden %}

                    {
                        data: "{{ column.fieldName }}"
                    },

                    {% elseif column.type == 'action' %}
                    {
                        data: "{{ column.fieldName }}",

                        render: function (data, type, row) {
                            var idTpl = '#' + '{{ column.cellAction.functionName }}{{ column.cellAction.targetEntity }}';
                            var tpl = $(idTpl).html();
                            return tpl.replace('[[data]]', data);
                        }
                    },
                    {% elseif column.type == 'checkbox' %}
                    {
                        data: null,
                        render: function (data, type, row) {
                            return $('#checkboxTpl').html();
                        }
                    },
                    {% elseif column.type == 'icon' %}
                    {
                        data: "{{ column.fieldName }}",
                        render: function (data, type, row) {
                            var tpl = $('#icon').html();
                            return tpl.replace('[[data]]', data);

                        }
                    },
                    {% endif %}

                    {% endfor %}
                ],

                {% if table.filters is not empty %}
                colReorder: true,
                {% endif %}

                columnDefs: [
                    {% for column in table.columns if column.hidden %}
                    {
                        "targets": [ {{ column.index }} ],
                        "visible": false,
                        "searchable": true
                    },
                    {% endfor %}
                ]
            });

            $('.single-filter .custom-select').on('change', function () {
                console.log(this.value);
                console.log($(this).attr('colIndex'));

                table
                    .column($(this).attr('colIndex'))
                    .search(this.value)
                    .draw()
            });
            $('#searchBar').on('keyup change', function () {
                table
                    .search(this.value)
                    .draw()
            });

            $('.multiple-filter').on('keyup change', function () {
                table.draw();
            });

            $('#dataTable tbody').on('click', 'tr td label input', function () {

                var row = this.parentNode.parentNode.parentNode;
                if ($(row).hasClass('selected')) {
                    $(row).removeClass('selected');
                } else {
                    $(row).addClass('selected');
                }
                var rows = table.rows('.selected').data();
                countSelectedRows(rows);
            });


            {% for globalAction in table.globalActions %}

            {% if globalAction.type == 'export-csv' %}

            $('#{{ globalAction.type }}').click(function () {
                var data = table.rows('.selected').data();
                var formatedData = formatDataToCsv(data);
                exportToCsv('export.csv', formatedData)
            });

            {% elseif globalAction.type == 'update-sap' %}
            $('#{{ globalAction.type }}{{ globalAction.config.targetDataType }}{{ globalAction.config.entity }}{{ globalAction.index }}').click(function () {

                var modal =
                    $('#{{ globalAction.type }}{{ globalAction.config.entity }}{{ globalAction.config.targetDataType }}{{ globalAction.index }}');
                modal.modal('show');

                {% if globalAction.config.targetDataType == 'static' %}
                var rows = table.rows('.selected').data();
                modal.find('.modal-body').html(
                    '<p class="text-gray text-center"><i class="fas fa-info-circle mr-2"></i>' + rows.length + ' ligne(s) sélectionnée(s)</p>');
                {% endif %}

            });


            $('#form{{ globalAction.config.entity }}{{ globalAction.config.targetField }}{{ globalAction.config.entityKey }}{{ globalAction.config.targetDataType }}{{ globalAction.index }}').click(function (other) {
                var modal =
                    $('#{{ globalAction.type }}{{ globalAction.config.entity }}{{ globalAction.config.targetDataType }}{{ globalAction.index }}');

                var data = table.rows('.selected').data();
                var targetEntity = $(this).attr('targetEntity');
                var targetField = $(this).attr('targetField');
                var entityKey = $(this).attr('entityKey');

                {% if globalAction.config.targetDataType == 'static' %}
                var targetData = $(this).attr('targetData');
                updateSap(data, targetEntity, targetField, entityKey, targetData, modal, true);
                {% else %}
                var targetData = $('#input{{ globalAction.type }}{{ globalAction.config.targetField }}{{ globalAction.config.targetDataType }}').val();
                updateSap(data, targetEntity, targetField, entityKey, targetData, modal);
                {% endif %}
            });
            {% endif %}
            {% endfor %}
        })
    </script>
{% endblock %}