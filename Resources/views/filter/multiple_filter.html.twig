<div class="input-group mt-1">
    {% for filter in table.filters if filter.active == 'Y' %}
        {% if filter.type == 'multiple' %}
            <div class="input-group-prepend">
                <span class="input-group-text">{{ filter.label }}</span>
            </div>
            {% if filter.defaultValue != null and filter.defaultValue != "" %}
                <input type="text" value="{{ filter.defaultValue['min'] }}"
                       class="form-control multiple-filter" id="min{{ filter.fieldName }}">
                <input type="text" value="{{ filter.defaultValue['max'] }}"
                       class="form-control multiple-filter" id="max{{ filter.fieldName }}">
            {% else %}
                <input type="text" class="form-control multiple-filter" id="min{{ filter.fieldName }}">
                <input type="text" class="form-control multiple-filter" id="max{{ filter.fieldName }}">
            {% endif %}
        {% elseif filter.type == 'multiple-date' %}
            <div class="input-group-prepend">
                <span class="input-group-text">{{ filter.label }}</span>
            </div>
            {% if filter.defaultValue != null and filter.defaultValue != "" %}
                <input type="date" value="{{ filter.defaultValue['min'] }}"
                       class="form-control multiple-filter" id="min{{ filter.fieldName }}">
                <input type="date" value="{{ filter.defaultValue['max'] }}"
                       class="form-control multiple-filter" id="max{{ filter.fieldName }}">
            {% else %}
                <input type="date" class="form-control multiple-filter" id="min{{ filter.fieldName }}">
                <input type="date" class="form-control multiple-filter" id="max{{ filter.fieldName }}">
            {% endif %}
        {% endif %}
    {% endfor %}
</div>
