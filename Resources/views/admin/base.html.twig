{% extends '@W3comHulk/display/base.html.twig' %}

{% block content %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-3 nav-admin-hulk">
                {% include '@W3comHulk/admin/nav.html.twig' %}
            </div>
            <div class="col-9 ml-auto">
                {% block page %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        function addLoadingIcon(obj) {
            $(obj).html('<i class="fas fa-spinner fa-spin mr-3"></i>' + $(obj).text());
        }

        $('#searchBar').on('keyup change', function () {
            table.rows().deselect();
            table
                .search(this.value)
                .draw();
        });
        $('.input-group').removeClass('w-25 ml-3');


    </script>
    {% block additionnalJs %}
    {% endblock %}
{% endblock %}