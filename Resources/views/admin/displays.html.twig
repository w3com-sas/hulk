{% extends '@W3comHulk/admin/base.html.twig' %}

{% set active = 'displays' %}

{% block page %}
    <h4 class="title-admin-hulk mt-3">Display ({{ displays|length }})</h4>
    <div class="alert alert-info">
        <i class="fa fa-info mr-3"></i>
        Ci-dessous vous retrouverez les displays disponibles dans l'application.
        Ceux-ci doivent être renseigné dans le fichier "configuration.json".
    </div>
    <a class="btn btn-block btn-success" href="{{ path('w3com_admin_update_displays') }}">
        Mettre à jours les displays
    </a>
    <table class="table table-sm" id="calculationViewTable">
        <thead>
            <tr>
                <th scope="col">Fichier</th>
                <th scope="col">Calculation View</th>
                <th scope="col">Nombre d'erreurs</th>
                <th scope="col">Liste des erreurs</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
{% endblock %}

{% block additionnalJs %}
    <script>
        function format(d) {
            var tpl = '<table cellpadding="5" cellspacing="0" border="0" style="padding-left:50px;">';
            for (i = 0; i < d.length; i++) {
                tpl += '<tr><td>' + d[i].name + '</td></tr>';
            }
            tpl += '</table></div>';
            return tpl;
        }
        $('table tbody').on('click', 'td.details-control', function () {

            var tr = $(this).closest('tr');
            var row = table.row(tr);

            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
                tr[0].lastChild.innerHTML = '<i class="fa fa-plus-circle text-success properties-plus">';
            } else {
                tr[0].lastChild.innerHTML = '<i class="fas fa-minus-circle text-success properties-plus"></i>';
                console.log(row.data().errors);
                row.child(format(row.data().errors)).show();
                tr.addClass('shown');
            }
        });

        var data = [
            {% for display in displays %}

            {
                'filename': '{{ display.filename }}',
                'cv': '{{ display.calcView }}',
                'errorsLength': '{{ display.error.all|length }}',
                'errors': [
                    {% for error in display.error.all %}
                    {'name': '{{ error }}'},
                    {% endfor %}
                ]
            },
            {% endfor %}
        ];

        var table = $('#calculationViewTable').DataTable({
            language: {
                search: "Rechercher&nbsp;:",
                zeroRecords: "Aucun &eacute;l&eacute;ment &agrave; afficher",
                emptyTable: "Aucune donnée disponible dans le tableau"
            },
            dom: 'tp',
            data: data,
            "columns": [

                {"data": "filename"},
                {"data": "cv"},
                {"data": "errorsLength"},
                {
                    "className": 'details-control',
                    "orderable": false,
                    "data": null,
                    "defaultContent": '<i class="fa fa-plus-circle text-success properties-plus">'
                }
            ],
        });
    </script>
{% endblock %}