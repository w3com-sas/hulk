<table class="table bg-white" id="dataTable" style="max-height: 500px;">
    <thead>
    <tr role="row">
        {% for column in table.columns if column.active == 'Y' and column.hidden is null %}
            <th>{{ column.label }}</th>
        {% endfor %}
    </tr>
    </thead>
    <tbody>
    </tbody>
</table>