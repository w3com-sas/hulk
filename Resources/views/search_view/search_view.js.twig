

var searchViewInput = document.getElementById('searchBarView'+'{{ searchView.calcView }}');

searchViewInput.addEventListener('keyup', function (event) {

    var columns = {};
    {% for column, displayName in searchView.columns %}
    columns.{{ column }} = '{{ displayName }}';
    {% endfor %}

    var data = {};
    data.entity = '{{ searchView.calcView }}';
    data.columns = columns;


    if (event.keyCode === 13) {

        var searchViewResults = $('#searchViewResults'+'{{ searchView.calcView }}');
        var searchViewInfo = $('#searchViewInfo'+'{{ searchView.calcView }}');
        var loader = $('#searchViewLoader'+'{{ searchView.calcView }}');

        searchViewResults.html('');
        searchViewInfo.html(loader.html());

        data.search = event.currentTarget.value;

        $.ajax({
            method: "POST",
            data: data,
            url: '{{ path('w3com_search_view') }}',
            success: function (data, response) {


                if (response === 'nocontent') {
                    searchViewInfo.html($('#searchViewNoResults'+'{{ searchView.calcView }}').html())
                } else {
                    searchViewResults.html(data);
                    searchViewInfo.html('');
                }
            }
        })

    }

});
