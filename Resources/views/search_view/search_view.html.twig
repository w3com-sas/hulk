<div class="input-group mb-3">
    <div class="input-group-prepend prepend-search-view">
        <span class="input-group-text">
            <i class="fa fa-search"></i>
        </span>
    </div>
    <input type="text" class="form-control" id="searchBarView">
</div>

<div class="row">
    <div class="col">
        <table class="table table-hover">
            <thead class="thead-primary">
            <tr>
                {% for column, displayName in searchView.columns %}
                    <th scope="col">{{ displayName }}</th>
                {% endfor %}
            </tr>
            </thead>
            <tbody id="searchViewResults">

            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-center" id="searchViewInfo">
</div>

<template id="searchViewLoader">
    <i class="fas fa-spinner fa-spin fa-5x text-primary"></i>
</template>

<template id="searchViewNoResults">
    <p class="text-muted">
        <i class="fas fa-exclamation-triangle mr-3"></i>
        Aucune donnée ne correspond à votre recherche
    </p>
</template>

