{% extends '@W3comHulk/display/base.html.twig' %}
{% form_theme form '@W3comHulk/display/form/filter_theme.html.twig' %}

{% block containerClass %}container fullHeightContainer{% endblock %}
{% block rowClass %}row h-100{% endblock %}
{% block colClass %}col my-auto{% endblock %}

{% block content %}
    <div class="collapse" id="hulkNav">
        {% set menu = knp_menu_get('main', [], {'displayName' : 'Formulaire '~display.entity }) %}
        {{ knp_menu_render(menu, {'template' : '@W3comHulk/display/include/menu.html.twig'}) }}
    </div>
    {{ form(form) }}
{% endblock %}