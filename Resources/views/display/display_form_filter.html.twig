{% extends '@W3comHulk/display/base.html.twig' %}
{% form_theme form '@W3comHulk/display/form/filter_theme.html.twig' %}

{% block content %}
    <div class="collapse" id="hulkNav">
        {% set menu = knp_menu_get('main', [], {'displayName' : 'Formulaire '~display.entity, 'menuName' : display.menuName }) %}
        {{ knp_menu_render(menu, {'template' : '@W3comHulk/display/include/menu.html.twig'}) }}
    </div>
    {% if display.hasCriticalError %}
        {% include '@W3comHulk/display/error/critical_error.html.twig' %}
    {% else %}
        {{ form(form) }}
    {% endif %}
{% endblock %}