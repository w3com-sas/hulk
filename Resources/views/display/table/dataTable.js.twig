// Datatables plugin to sort datetime data with moment js

(function (factory) {
    if (typeof define === "function" && define.amd) {
        define(["jquery", "moment", "datatables.net"], factory);
    } else {
        factory(jQuery, moment);
    }
}(function ($, moment) {
    $.fn.dataTable.moment = function (format, locale) {
        var types = $.fn.dataTable.ext.type;

        // Add type detection
        types.detect.unshift(function (d) {
            if (d) {
                // Strip HTML tags and newline characters if possible
                if (d.replace) {
                    d = d.replace(/(<.*?>)|(\r?\n|\r)/g, '');
                }

                // Strip out surrounding white space
                d = $.trim(d);
            }

            // Null and empty values are acceptable
            if (d === '' || d === null) {
                return 'moment-' + format;
            }

            return moment(d, format, locale, true).isValid() ?
                'moment-' + format :
                null;
        });

        // Add sorting method - use an integer for the sorting
        types.order['moment-' + format + '-pre'] = function (d) {
            if (d) {
                // Strip HTML tags and newline characters if possible
                if (d.replace) {
                    d = d.replace(/(<.*?>)|(\r?\n|\r)/g, '');
                }

                // Strip out surrounding white space
                d = $.trim(d);
            }

            return !moment(d, format, locale, true).isValid() ?
                Infinity :
                parseInt(moment(d, format, locale, true).format('x'), 10);
        };
    };

}));


$(document).ready(function () {

    // Add all datetime format here
    $.fn.dataTable.moment('DD/MM/YYYY');

    var data = [
        {% for object in display.data %}

        {
            'idLines': 'line{{ loop.index }}',
            {% for col, value in object %}
            '{{ col }}': '{{ value }}',

            {% endfor %}
        },
        {% endfor %}
    ];
    var table = $('#dataTable').DataTable({
            language: {
                processing: "Traitement en cours...",
                search: "Rechercher&nbsp;:",
                lengthMenu: "Afficher _MENU_ &eacute;l&eacute;ments",
                info: "Affichage de l'&eacute;lement _START_ &agrave; _END_ sur _TOTAL_ &eacute;l&eacute;ments",
                infoEmpty: "Affichage de l'&eacute;lement 0 &agrave; 0 sur 0 &eacute;l&eacute;ments",
                infoFiltered: "(filtr&eacute; de _MAX_ &eacute;l&eacute;ments au total)",
                infoPostFix: "",
                loadingRecords: "Chargement en cours...",
                zeroRecords: "Aucun &eacute;l&eacute;ment &agrave; afficher",
                emptyTable: "Aucune donnée disponible dans le tableau"
            },
            dom: 'tp',
            pageLength: {{ display.pageLength }},
            fnDrawCallback: function (settings) {
                $('a').parent('td').addClass('text-center');
                $('button').parent('td').addClass('text-center');
                $('i').parent('td').addClass('text-center');
            },
            data: data,
            columns: [



                {% for column in display.columns if column.active == 'Y' %}
                {# Set dynamic icon #}


                {% if column.type == 'text' or column.hidden %}

                {
                    {% if column.width is not null %}
                    width: "{{ column.width }}%",
                    {% endif %}
                    data:
                        "{{ column.fieldName }}"
                }
                ,

                {% elseif column.type == 'action' %}
                {% if column.cellAction.functionName == 'openForm' %}
                {
                    {% if column.width is not null %}
                    width: "{{ column.width }}%",
                    {% endif %}

                    data: "{{ column.fieldName }}",

                    render: function (data, type, row) {
                        var idTpl = '#' + '{{ column.cellAction.functionName }}{{ column.index }}';
                        var tpl = $(idTpl).html();

                        if (data == '') {
                            return null;
                        }

                        {% if column.cellAction.iconFieldName is not null %}
                        var icon = row.{{ column.cellAction.iconFieldName }};

                        return tpl.replace('[[icon]]', icon).replace('[[data]]', data);
                        {% else %}
                        return tpl.replace('[[data]]', data);
                        {% endif %}
                    }
                }
                ,
                {% elseif column.cellAction.functionName == 'displayLink' or column.cellAction.functionName == 'link' %}
                {
                    {% if column.width is not null %}
                    width: "{{ column.width }}%",
                    {% endif %}
                    data: "{{ column.cellAction.functionName }}{{ column.cellAction.targetEntity }}",
                    render:
                        function (data, type, row) {
                            if (data === ''|| data === undefined||data === null) {
                                return null;
                            }

                            var idTpl = '#' + '{{ column.cellAction.functionName }}{{ column.cellAction.targetEntity }}';
                            var tpl = $(idTpl).html();
                            return tpl.replace('[[data]]', data);
                        }
                }
                ,
                {% endif %}
                {% elseif column.type == 'checkbox' %}
                {
                    data: 'idLines',
                    render:
                        function (data, type, row) {
                            return $('#checkboxTpl').html().replace('idLine', data);
                        }
                }
                ,
                {% elseif column.type == 'icon' %}
                {
                    {% if column.width is not null %}
                    width: "{{ column.width }}%",
                    {% endif %}
                    data:
                        "{{ column.fieldName }}",
                    render:

                        function (data, type, row) {
                            var tpl = $('#icon').html();
                            if (data.split(' ').length == 1) {
                                data = 'fa fa-' + data;
                            }
                            return tpl.replace('[[data]]', data);
                        }
                }
                ,
                {% elseif column.type == 'universal' %}
                {
                    {% if column.width is not null %}
                    width: "{{ column.width }}%",
                    {% endif %}
                    data: null,
                    render: function (data, type, row) {
                        var iconRenderer = '';
                        var tplIcon = $('#icon').html();
                        if (row.hasOwnProperty('{{ column.iconFieldName }}') && (row.{{ column.iconFieldName }} != '')) {
                            var prefixIcon = '';
                            if (row.{{ column.iconFieldName }}.
                            split(' ').length == 1
                        )
                            {
                                prefixIcon = 'fa fa-';
                            }
                            iconRenderer = tplIcon.replace('[[data]]', prefixIcon + row.{{ column.iconFieldName }});
                        } else {
                            iconRenderer = tplIcon.replace('[[data]]', '{{ column.cellAction.icon }}')
                        }

                        var labelRenderer = '';
                        if (row.hasOwnProperty('{{ column.labelFieldName }}') && row.{{ column.labelFieldName }} != '') {
                            var tplLabel = $('#labelRenderer').html();
                            labelRenderer = tplLabel.replace('[[data]]', row.{{ column.labelFieldName }});
                        }

                        {% if column.cellAction is defined %}
                        var tplAction = $('#action{{ column.cellAction.functionName }}{{ column.index }}').html();

                        tplAction = tplAction
                            .replace('[[globalRender]]', iconRenderer + labelRenderer)
                            .replace('[[row]]', JSON.stringify(row).replace(/"/g, '&quot;'));

                        {% if column.cellAction.renderType is defined and column.cellAction.renderType == 'dynamic' %}
                        tplAction = tplAction.replace('[[classRender]]', row.{{ column.cellAction.renderFieldName }})
                        {% endif %}

                        return tplAction;

                        {% else %}
                        return iconRenderer + labelRenderer;
                        {% endif %}
                    }
                }
                ,
                {% elseif column.type == 'update-sap' %}
                {
                    data: '{{ column.fieldName }}',
                    render: function (data, type, row) {
                        return '<input type="text" value="' + data + '"' +
                            'class="form-control form-control-sm"' +
                            'data-entity="' + '{{ column.config.entity }}' +
                            '" data-field-name="' + '{{ column.fieldName }}' +
                            '" data-key="' + row.{{ column.config.entityKey }} +
                            '" onchange="updateSapLine(this)"/>';
                    }
                },
                {% endif %}

                {% endfor %}
            ],
            colReorder: false,
            order: [],
            columnDefs:
                [
                    {% for column in display.columns %}

                    {% if column.type == 'checkbox' %}
                    {
                        "targets": [ {{ column.index }} ],
                        "orderable": false
                    },
                    {% elseif column.hidden %}
                    {
                        "targets": [ {{ column.index }} ],
                        "visible": false,
                        "searchable": true,
                        "orderable": false
                    },
                    {% elseif column.orderable %}
                    {
                        "targets": [ {{ column.index }} ],
                        "visible": true,
                        "searchable": true,
                        "orderable": true
                    },
                    {% elseif column.width is not null %}
                    {
                        "target": [ {{ column.index }} ],
                        "visible": true,
                        "searchable": true,
                        "width": {{ column.width }}
                    },
                    {% else %}
                    {
                        "targets": [ {{ column.index }} ],
                        "visible": true,
                        "searchable": true,
                        "orderable": false
                    },
                    {% endif %}
                    {targets: 'no-sort', orderable: false},
                    {% endfor %}
                ],
            drawCallback:

                function () {

                    var selectedRows = $('#dataTable tbody .selected');
                    var headerCheckbox = $('#headerCheckbox input');
                    var allRows = $('#dataTable tbody tr');

                    if (selectedRows.length === allRows.length) {
                        headerCheckbox.prop("checked", true)
                        $('#dataTable tbody tr label input').prop('checked', true)
                    } else {
                        headerCheckbox.prop("checked", false)
                        $('#dataTable tbody tr label input').prop('checked', false)
                    }

                }
        })
    ;



    {% include '@W3comHulk/display/filter/filter.js.twig' %}

    $('#dataTable tbody').on('click', 'tr td label input', function () {

        var row = this.parentNode.parentNode.parentNode;
        if ($(row).hasClass('selected')) {
            $(row).removeClass('selected');
        } else {
            $(row).addClass('selected');
        }
        var rows = table.rows('.selected').data();
        countSelectedRows(rows);
    });

    $('#selectAllLines :checkbox').on('click', function () {

        if (this.checked) {
            table.rows({search: 'applied'}).select();
            $('#dataTable tbody tr label input').prop('checked', true)
            $('#headerCheckbox input').prop('checked', true);

        } else {
            table.rows().deselect();
            $('#dataTable tbody tr label input').prop('checked', false)
            $('#headerCheckbox input').prop('checked', false);

        }
        countSelectedRows(table.rows('.selected').data());
    });

    $('#headerCheckbox :checkbox').on('click', function () {

        if (this.checked) {
            $('#dataTable tbody tr').addClass('selected')
            $('#dataTable tbody tr label input').prop('checked', true)
        } else {
            $('#dataTable tbody tr').removeClass('selected')
            $('#dataTable tbody tr label input').prop('checked', false)

        }
        countSelectedRows(table.rows('.selected').data())
    });

    {% include '@W3comHulk/display/action/global_action.js.twig' %}
})
