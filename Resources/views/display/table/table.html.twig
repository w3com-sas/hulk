<table class="table" id="dataTable">
    <thead>
    <tr role="row">
        {% for column in display.columns if column.active == 'Y' and column.hidden is null %}
            {% if column.type == 'checkbox' %}
                <th>
                    <label class="checkbox-label-header" id="headerCheckbox">
                        <input type="checkbox">
                        <span class="checkbox-custom rectangular"></span>
                    </label>
                </th>
            {% else %}
                <th>{{ column.label }}</th>
            {% endif %}
        {% endfor %}
    </tr>
    </thead>
    <tbody>

    </tbody>
</table>
