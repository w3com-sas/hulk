<table class="table" id="dataTable">
    <thead>
    <tr role="row">
        {% for column in display.columns %}
            {% if column.active == 'Y' and column.hidden is null %}
                {% if column.type == 'checkbox' %}
                    <th>
                        <label class="checkbox-label-header" id="headerCheckbox">
                            <input type="checkbox">
                            <span class="checkbox-custom rectangular"></span>
                        </label>
                    </th>
                {% elseif column.cellAction and column.cellAction.functionName == 'displayLinks' %}
                    <th>
                        <div class="dropdown">
                            <button class="dropdown-toggle btn" type="button" id="dropdownMenuButton{{ column.index }}"
                                    data-toggle="dropdown">
                                {{ column.label }}
                            </button>
                            <div class="dropdown-menu display-choices-type" id="dropDownMenu{{ column.index }}"
                                 data-display="{{ column.cellAction.params['Displays'][0] }}">
                                {% for key,param in column.cellAction.params['Displays'] %}
                                    <button type="button" class="dropdown-item">{{ param }}</button>
                                {% endfor %}
                            </div>
                        </div>
                    </th>
                {% else %}
                    <th>
                        {{ column.label }}
                    </th>
                {% endif %}
            {% endif %}
        {% endfor %}
    </tr>
    </thead>
    <tbody>
    </tbody>
</table>
