$.fn.dataTable.ext.search.push(
    function (settings, data) {

        {# Trie les data à chaque "draw()" du tableau #}
        {# data = ligne du tableau #}
        {% for filter in display.filters if filter.active == 'Y' and (filter.type == 'multiple'
            or filter.type == 'multiple-date') and display.data is not empty %}

        window['minId{{ filter.fieldName }}'] = '#min' + '{{ filter.fieldName }}';
        window['maxId{{ filter.fieldName }}'] = '#max' + '{{ filter.fieldName }}';

        {% if filter.type == 'multiple' and filter.active == 'Y' %}

        var minVal = parseInt($(window['minId{{ filter.fieldName }}']).val(), 10);
        var maxVal = parseInt($(window['maxId{{ filter.fieldName }}']).val(), 10);
        var dataToCompare = parseInt(data[{{ filter.index }}], 10);

        {% elseif filter.type == 'multiple-date' and filter.active == 'Y' %}



        var minValues = $(window['minId{{ filter.fieldName }}']).val().split('/');
        var maxValues = $(window['maxId{{ filter.fieldName }}']).val().split('/');
        var minVal = parseInt(new Date(minValues[2], minValues[1] - 1, minValues[0]).getTime());
        var maxVal = parseInt(new Date(maxValues[2], maxValues[1] - 1, maxValues[0], 23, 59).getTime());
        var datumToCompare = data[{{ filter.index }}].split('/');
        var dataToCompare = parseInt(new Date(datumToCompare[2], datumToCompare[1] - 1, datumToCompare[0]).getTime());

        {% endif %}


        // Si les champs ne sont pas remplis osef
        if (!isNaN(minVal) || !isNaN(maxVal)) {

            // Si la data est vide on l'exclu
            if (!isNaN(dataToCompare)) {

                // Si la data n'est pas dans l'interval on l'exclu
                if (dataToCompare < minVal || dataToCompare > maxVal) {
                    return false;
                }
            } else {
                return false;
            }

        }

        {% endfor %}

        return true;

    }
);

