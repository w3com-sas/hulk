function saveFilters() {
    var data = {};
    data.currentRoute = '{{ app.request.get('_route') }}{{ app.request.get('filename') }}';
    data.filters = {};

    {% for filter in display.filters %}
    {% if filter.active == 'Y' and filter.type == 'single' %}

    data.filters.{{ filter.fieldName }} = $('#select{{ filter.fieldName }}').val();
    {% endif %}
    {% endfor %}


    {% for filter in display.filters %}
    {% if filter.active == 'Y' and (filter.type == 'multiple' or filter.type == 'multiple-date') %}

    data.filters.{{ filter.fieldName }} = {
        min: $('#min{{ filter.fieldName }}').val(),
        max: $('#max{{ filter.fieldName }}').val()
    }

    {% endif %}
    {% endfor %}
    data.filters.searchBar = $('#searchBar').val();
    data.filters.targetColumn = $('#targetColumn').val();

    $.ajax({
        method: "POST",
        data: data,
        url: '{{ url('w3com_save_filters') }}',
        success: function (data) {
            var countFilter = document.getElementById('countFilters');
            var startSubstr = countFilter.innerHTML.indexOf('(');
            var endSubstr = countFilter.innerHTML.indexOf(')');
            countFilter.innerHTML = countFilter.innerHTML.replace(countFilter.innerHTML.substr(startSubstr, endSubstr),
                '(' + data.countFilters + ')');
            if (data.countFilters > 0) {
                countFilter.querySelector('i').classList.remove('fal');
                countFilter.querySelector('i').classList.add('fas');
                countFilter.classList.remove('text-gray-1');
                countFilter.classList.add('text-warning');
            } else {
                countFilter.querySelector('i').classList.remove('fas');
                countFilter.querySelector('i').classList.add('fal');
                countFilter.classList.remove('text-warning');
                countFilter.classList.add('text-gray-1');
            }
        }
    })
}





