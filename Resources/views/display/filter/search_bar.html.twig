<div class="input-group ml-3 w-25 my-auto">
    <div class="input-group-prepend">
        <label class="input-group-text" for="#searchBar">
            <i class="fas fa-search"></i>
        </label>
    </div>
    <select class="form-control" id="targetColumn">
    </select>
    <input
            type="text" class="form-control"
            id="searchBar"
            placeholder="Recherche générale"
            {{ (display.filters.searchBar is defined) ? 'value='~display.filters.searchBar.defaultValue~'' : '' }}
    />
</div>