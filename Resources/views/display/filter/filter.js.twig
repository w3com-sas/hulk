$('.single-filter .custom-select').on('change', function () {

    table.rows().deselect();
    table
        .column($(this).attr('colIndex'))
        .search(this.value.toString())
        .draw();
    saveFilters();
    countSelectedRows(table.rows('.selected').data());

});
$('#searchBar').on('keyup change', function () {
    table.rows().deselect();
    table
        .search(this.value)
        .draw();
    saveFilters();
    countSelectedRows(table.rows('.selected').data());
});

// Multiple filter become active when the table is draw in something like fnEventRedraw
$('.multiple-filter').on('keyup change', function () {
    table.rows().deselect();
    table.draw();
    saveFilters();
    countSelectedRows(table.rows('.selected').data());
});

{% for filter in display.filters if filter.defaultValue != null and filter.defaultValue != ""
 and filter.defaultValue is not iterable %}
{% if filter.type == 'single' %}
table
    .column({{ filter.index }})
    .search('{{ filter.defaultValue }}')
    .draw();
{% else %}
table.draw();
{% endif %}
{% endfor %}