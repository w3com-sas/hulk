{% block eventListener %}
$('.single-filter .custom-select').on('change', function () {
    table.rows().deselect();
    table
        .column($(this).attr('colIndex'))
        .search(this.value.toString())
        .draw();
    saveFilters();
    countSelectedRows(table.rows('.selected').data());

});
$('#searchBar').on('change', function () {
    var colIndex = $('#targetColumn').val();
    table.search('').columns().search('').draw();
    table.rows().deselect();
    var element = colIndex === 'all' ? table : table.column(colIndex);
    element
        .search(this.value)
        .draw();
    saveFilters();
    countSelectedRows(table.rows('.selected').data());
});

$('#targetColumn').on('change', function () {
    var searchVal = $('#searchBar').val();
    table.search('').columns().search('').draw();
    table.rows().deselect();
    var element = this.value === 'all' ? table : table.column(this.value);
    element
        .search(searchVal)
        .draw();
    saveFilters();
    countSelectedRows(table.rows('.selected').data());
});

// Multiple filter become active when the table is draw in something like fnEventRedraw
$('.multiple-filter').on('keyup change', function () {
    table.rows().deselect();
    table.draw();
    saveFilters();
    countSelectedRows(table.rows('.selected').data());
});
{% endblock %}

{% block dataTableApi %}
{% for filter in display.filters %}
{% if filter.defaultValue != null and filter.defaultValue != ""
    and filter.defaultValue is not iterable %}
{% if filter.type == 'single' %}
table
    .column({{ filter.index }})
    .search('{{ filter.defaultValue }}')
    .draw();
{% else %}
table.draw();
{% endif %}
{% endif %}
{% endfor %}
{% endblock %}
{% if display.filters.searchBar is defined %}
{% if display.filters.targetColumn is defined and display.filters.targetColumn.defaultValue != 'all' %}
var element = table.column({{ display.filters.targetColumn.defaultValue }});
{% else %}
var element = table;
{% endif %}
element.search('{{ display.filters.searchBar.defaultValue }}').draw();
{% endif %}