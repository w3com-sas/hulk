{% for filter in display.filters %}
    {% if filter.type == constant('W3com\\HulkBundle\\Model\\Filter::TYPE_PRE_FILTER') %}
        {% for param in filter.params %}
            <span class="badge badge-info">{{ param|formatIfDate }}</span>
        {% endfor %}
    {% endif %}
{% endfor %}
{% for param, value in app.request.query.all %}
    {% if param not in ['username','companydb','slcontext'] %}
        {% if param == "SEARCH" %}
            <span class="badge badge-info">{{ value|explodeSpace }}</span>
        {% else %}
            <span class="badge badge-info">{{ value|formatIfDate }}</span>
        {% endif %}
    {% endif %}
{% endfor %}
