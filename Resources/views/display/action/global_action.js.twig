{% for globalAction in table.globalActions
    if globalAction.type == 'update-sap' or globalAction.type == 'api-request' %}

{% if globalAction.type == 'update-sap' %}
{% set btnModalId = '#btn'~globalAction.type~globalAction.config.targetDataType~globalAction.index %}
{% set btnFormId = '#form'~globalAction.type~globalAction.config.targetDataType~globalAction.index %}
{% set modalId = '#'~globalAction.type~globalAction.config.targetDataType~globalAction.index %}
{% set inputId = '#input'~globalAction.type~globalAction.config.targetField~globalAction.config.targetDataType %}
{% elseif globalAction.type == 'api-request' %}
{% set btnModalId = '#'~globalAction.type~globalAction.index %}
{% set btnFormId = '#form'~globalAction.type~globalAction.index %}
{% set modalId = '#modal'~globalAction.type~globalAction.index %}
{% endif %}

$('{{ btnModalId }}').click(function () {


    if (table.rows('.selected').data().length === 0) {
        var modal = $('#anyLines');
    } else {
        var modal = $('{{ modalId }}');
    }

    {% if globalAction.config.targetDataType == 'static' or globalAction.type == 'api-request' %}
    var rows = table.rows('.selected').data();
    modal.find('.modal-body').html(
        '<p class="text-gray text-center"><i class="fas fa-info-circle mr-2"></i>' + rows.length
        + ' ligne(s) sélectionnée(s)</p>');
    {% endif %}

    modal.modal('show');
});

$('{{ btnFormId }}').click(function () {

    var modal = $('{{ modalId }}');

    var data = table.rows('.selected').data();
    var targetEntity = $(this).attr('targetEntity');
    var targetField = $(this).attr('targetField');
    var entityKey = $(this).attr('entityKey');

    {% if globalAction.config.targetDataType == 'static' %}
    var targetData = $(this).attr('targetData');
    updateSap(data, targetEntity, targetField, entityKey, targetData, modal, true);

    {% elseif globalAction.type == 'update-sap' %}
    var targetData = $('{{ inputId }}').val();
    updateSap(data, targetEntity, targetField, entityKey, targetData, modal);

    {% elseif globalAction.type == 'api-request' %}

    var params = {};
    {% for param, targetParam in globalAction.config.targetData %}

    {% if targetParam is iterable %}
    params.{{ param }} = {};
    {% for field, targetField in targetParam %}
    params.{{ param }}.{{ field }} = '{{ targetField }}';
    {% endfor %}

    {% else %}
    params.{{ param }} = '{{ targetParam }}';
    {% endif %}
    {% endfor %}
    var url = '{{ globalAction.config.url }}'
    apiRequest(data, params, url, modal)

    {% endif %}
});
{% endfor %}


{% for globalAction in table.globalActions if globalAction.type == 'export-csv' %}
$('#{{ globalAction.type }}').click(function () {
    var data = table.rows('.selected').data().toArray();
    var jsonData = Object.assign({}, data);
    var filename = '{{ table.filename }}' + '.csv';

    xhttp = new XMLHttpRequest();
    xhttp.onreadystatechange = function () {
        var a;
        if (xhttp.readyState === 4 && xhttp.status === 200) {
            // Trick for making downloadable link
            a = document.createElement('a');
            a.href = window.URL.createObjectURL(xhttp.response);
            // Give filename you wish to download
            a.download = filename;
            a.style.display = 'none';
            document.body.appendChild(a);
            a.click();
        }
    };
    // Post data to URL which handles post request
    xhttp.open("POST", '{{ path('w3com_export_csv', {filename : table.filename }) }}');
    xhttp.setRequestHeader("Content-Type", "application/json");
    xhttp.setRequestHeader("accept", "application/json");
    // You should set responseType as blob for binary responses
    xhttp.responseType = 'blob';
    xhttp.send(JSON.stringify(jsonData));

});
{% endfor %}

{% for globalAction in table.globalActions if globalAction.type == 'call-function' %}
$('#{{ globalAction.type~globalAction.index }}').click(function () {
    var data = table.rows('.selected').data();
    {% if globalAction.config.name is defined %}
    eval('{{ globalAction.config.name }}(data)');
    {% endif %}

});
{% endfor %}