{% if table.error.nonexistentProperties is not null  %}
<div class="alert alert-danger">
    <i class="fas fa-exclamation-triangle mr-2"></i>
    {{ table.error.nonexistentProperties }} champ(s) renseigné(s) dans le
    fichier json
</div>
{% endif %}

{% if table.error.isFileIsBroken  %}
<div class="alert alert-danger">
    <i class="fas fa-exclamation-triangle mr-2"></i>
    Impossible de lire le fichier JSON. Il semblerait qu'il y ai
    une erreur de syntaxe.
</div>
{% endif %}

{% for filterError in table.error.filterErrors  %}
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle mr-2"></i>
        Filtre : {{ filterError }}
    </div>
{% endfor %}

{% for columnError in table.error.columnErrors  %}
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle mr-2"></i>
        Colonne : {{ columnError }}
    </div>
{% endfor %}

{% for urlError in table.error.urlErrors  %}
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle mr-2"></i>
        URL : {{ urlError }}
    </div>
{% endfor %}