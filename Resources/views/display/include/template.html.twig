{% for renderElement in display.renderElements %}
    <template id="{{ renderElement.elementId }}">
        <input
            value="[[data]]"
        {% for attrname, attrvalue in renderElement.elementAttr %}
            {{ " " }}
            {% if attrvalue is same as(true) %}
                {{ attrname }}="{{ attrname }}"
            {% elseif attrvalue is not same as(false) %}
                {{ attrname }}="{{ attrvalue }}"
            {% endif %}
        {% endfor %}
        />
    </template>
{% endfor %}

<template id="checkboxTpl">
    <label class="checkbox-label">
        <input type="checkbox" id="idLine">
        <span class="checkbox-custom rectangular"></span>
    </label>
</template>

<template id="loader">
    <div class="row">
        <div class="col text-center">
            <i class="fas fa-spin fa-spinner fa-4x my-3 text-primaru"></i>
        </div>
    </div>
</template>

<template id="icon">
    <i class="[[data]]"></i>
</template>

<template id="labelRenderer">
    [[data]]
</template>

<template id="actionRenderer">
    <a href="[[action]]" class="[[class]]">
        [[data]]
    </a>
</template>

<div class="modal fade"
     id="anyLines"
     tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header flex-column">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    Aucune ligne n'a été sélectionnée.
                </h5>
            </div>
        </div>
    </div>
</div>

<template id="reporting">
    <div class="accordion" id="accordionReport">
        <div class="card">
            <div class="card-header" id="headingOne">
                <h2 class="mb-0">
                    <button class="btn btn-link text-success" type="button" data-toggle="collapse"
                            data-target="#collapseOne">
                        [[headerTextSuccess]]
                    </button>
                </h2>
            </div>
            <div id="collapseOne" class="collapse show" data-parent="#accordionReport">
                <div class="card-body">

                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header" id="headingTwo">
                <h2 class="mb-0">
                    <button class="btn btn-link text-danger collapsed" type="button" data-toggle="collapse"
                            data-target="#collapseTwo">
                        [[headerTextDanger]]
                    </button>
                </h2>
            </div>
            <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo" data-parent="#accordionReport">
                <div class="card-body">
                </div>
            </div>
        </div>
    </div>
</template>