<div class="d-flex my-2">
    {% if table.globalActions is not empty %}
        <a class="text-gray my-auto" data-toggle="collapse" href="#globalActions">
            <i class="far fa-hand-paper mr-2"></i>
            Actions
        </a>
    {% endif %}

    {% if table.filters is not null %}
        <a class="text-gray ml-3 my-auto" data-toggle="collapse" href="#filters" id="countFilters">
            <i class="fas fa-filter mr-2"></i>
            Filtres ({{ table.savedFilters }})
        </a>
    {% endif %}

    <a class="text-gray my-auto ml-3" href="">
        <i class="fas fa-sync mr-2"></i>
        Actualiser
    </a>
    <a class="text-gray my-auto ml-3" data-toggle="collapse" href="#hulkNav">
        <i class="fas fa-bars mr-2"></i>
        Menu
    </a>
    <div class="my-auto ml-3">
        <label class="checkbox-label-gray-1" id="selectAllLines">
            <input type="checkbox">
            <span class="checkbox-custom rectangular"></span>
        </label>
    </div>
    <p class="text-gray my-auto ml-2">Tout sélectionner</p>

    {% include '@W3comHulk/display/filter/search_bar.html.twig' %}
    <p class="text-gray my-auto mb-0 ml-2" style="font-size: small;">
            Actualisé à : {{ "now"|date("H:i")|replace({':' : 'h'}) }}
    </p>
    <p class="text-gray m-0 align-self-end ml-auto" id="countSelectedRows" style="display: none;font-size: small">
    </p>

</div>
<div class="row">
    <div class="col">
        <div class="collapse" id="filters">
            {% include '@W3comHulk/display/filter/single_filter.html.twig' %}
            {% include '@W3comHulk/display/filter/multiple_filter.html.twig' %}
        </div>
    </div>
</div>
<div class="row">
    <div class="col">
        <div class="collapse" id="globalActions">
            <div class="mt-3">
                {% include '@W3comHulk/display/action/global_action.html.twig' %}
            </div>
        </div>
    </div>
</div>
