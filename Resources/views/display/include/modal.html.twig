{% for globalAction in display.globalActions %}
    {% if globalAction.type in [
        constant('W3com\\HulkBundle\\Model\\GlobalAction::TYPE_UPDATE_SAP'),
        constant('W3com\\HulkBundle\\Model\\GlobalAction::TYPE_API_REQUEST')
    ] %}
        {% if globalAction.type is same as (constant('W3com\\HulkBundle\\Model\\GlobalAction::TYPE_UPDATE_SAP')) %}
            {% set modalId = globalAction.type~globalAction.config.targetDataType~globalAction.index %}
            {% set inputId = 'input'~globalAction.type~globalAction.config.targetField~globalAction.config.targetDataType %}
            {% set title = 'Mise à jour SAP :'~globalAction.config.entity %}
            {% set btnAttr = {
                'id' : 'form'~globalAction.type~globalAction.config.targetDataType~globalAction.index,
                'data-entity-name' : globalAction.config.entity,
                'data-affected-field': globalAction.config.targetField,
                'data-display-field-key': globalAction.config.entityKey
            } %}
            {% set btnAttr =
                globalAction.config.targetDataType is same as (constant('W3com\\HulkBundle\\Model\\Config::DATA_TYPE_STATIC'))
                ? btnAttr|merge({'data-affected-value' : globalAction.config.targetData })
                : btnAttr
            %}
            {% if globalAction.config.label is same as ('') %}
                {% set labelField = globalAction.config.label %}
            {% else %}
                {% set labelField = globalAction.config.targetDescription %}
            {% endif %}
        {% elseif globalAction.type == 'api-request' %}
            {% set modalId = 'modal'~globalAction.type~globalAction.index %}
            {% set btnFormId = 'form'~globalAction.type~globalAction.index %}
            {% set btnAttr = {'id' : btnFormId} %}
            {% set title = globalAction.label %}
        {% endif %}
        <div class="modal fade" id="{{ modalId }}" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: max-content;">
                <div class="modal-content">
                    <div class="modal-header flex-column">
                        <h5 class="modal-title text-center">
                            {{ title }}
                        </h5>
                    </div>
                    <div class="modal-body">
                        {% if globalAction.config.targetDataType is same as (constant('W3com\\HulkBundle\\Model\\Config::DATA_TYPE_TEXT')) %}
                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        {{ labelField }} :
                                    </span>
                                </div>
                                <input type="text" class="form-control" id="{{ inputId }}">
                            </div>
                        {%
                            elseif globalAction.config.targetDataType is same as (constant('W3com\\HulkBundle\\Model\\Config::DATA_TYPE_ARRAY'))
                            or globalAction.config.targetDataType is same as (constant('W3com\\HulkBundle\\Model\\Config::DATA_TYPE_CONTROLLED_LIST'))
                        %}
                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <label class="input-group-text" for="{{ inputId }}">
                                        {{ labelField }} :
                                    </label>
                                </div>
                                <select class="custom-select" id="{{ inputId }}">
                                    {% for key, value in globalAction.config.targetData %}
                                        {% if globalAction.config.targetDataType is same as (constant('W3com\\HulkBundle\\Model\\Config::DATA_TYPE_CONTROLLED_LIST')) %}
                                            <option value="{{ value.code }}">{{ value.name }}</option>
                                        {% else %}
                                            <option value="{{ key }}">{{ value }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                            </div>
                        {% elseif globalAction.config.targetDataType is same as (constant('W3com\\HulkBundle\\Model\\Config::DATA_TYPE_DATE')) %}
                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <label class="input-group-text">
                                        {{ labelField }} :
                                    </label>
                                </div>
                                <input type="text" class="form-control datepicker-here" data-language="fr" id="{{ inputId }}">
                            </div>
                        {% endif %}
                    </div>
                    <div class="modal-footer w-100 justify-content-between">
                        <button type="button" class="btn btn-secondary float-left" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>
                            Fermer
                        </button>
                        <button type="button" class="btn btn-success"
                            {% for attr, value in btnAttr %}
                                {% if value is not iterable %}
                                    {{ " " }}
                                    {{ attr|raw }}="{{ value|raw }}"
                                {% endif %}
                            {% endfor %}
                        >
                            <i class="far fa-paper-plane mr-2"></i>
                            Valider
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endfor %}

{% for action in display.globalActions %}
    {% if action.type in [
        constant('W3com\\HulkBundle\\Model\\GlobalAction::TYPE_CALL_FUNCTION'),
        constant('W3com\\HulkBundle\\Model\\GlobalAction::TYPE_API_CALL'),
        constant('W3com\\HulkBundle\\Model\\GlobalAction::TYPE_RENDER_VIEW'),
        constant('W3com\\HulkBundle\\Model\\GlobalAction::TYPE_EXPORT_CSV')
    ] %}
        {% set id =
            (action.type == constant('W3com\\HulkBundle\\Model\\GlobalAction::TYPE_CALL_FUNCTION'))
            ? action.config.name :
            action.type~action.index
        %}
        <div class="modal fade" id="{{ id }}" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document" style="max-width: max-content;">
                <div class="modal-content">
                    <div class="modal-header px-0" id="{{ id }}Header">
                        <div class="container">
                            <div class="row justify-content-between">
                                <h5 class="modal-title col-auto align-self-center" id="{{ id }}TextLoading">Texte</h5>
                                <div class="col-auto align-self-center">
                                    <div class="d-none icon-loading">
                                        <i class="fad fa-circle-notch fa-3x text-success fa-spin"></i>
                                    </div>
                                    <div class="d-none icon-item"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-body d-none" id="{{ id }}Body"></div>
                    <div class="modal-footer d-none" id="{{ id }}Footer"></div>
                </div>
            </div>
        </div>
    {% endif %}
{% endfor %}
