{% extends '@W3comHulk/display/base.html.twig' %}

{% block content %}
    {% if display.criticalError %}
        {% include '@W3comHulk/display/error/critical_error.html.twig' %}
    {% else %}
        {% include '@W3comHulk/display/display.html.twig' %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {% if not display.criticalError %}
        <script>
            {% include '@W3comHulk/display/display.js.twig' %}
        </script>
    {% endif %}
{% endblock %}
