{% extends '@W3comHulk/display/base.html.twig' %}
{% form_theme form '@W3comHulk/display_form/theme.html.twig' %}

{% block content %}
    <div class="container-fluid">
        <div class="collapse" id="hulkNav">
            {% set menu = knp_menu_get('main', [], {'displayName' : display.label, 'menuName' : display.menuName }) %}
            {{ knp_menu_render(menu, {'template' : '@W3comHulk/display/include/menu.html.twig'}) }}
        </div>
        {% if display.hasCriticalError %}
            {% include '@W3comHulk/display/error/critical_error.html.twig' %}
        {% else %}
            {{ form(form) }}
        {% endif %}
        {% if hasExceededMaxNumberLines is defined and hasExceededMaxNumberLines %}
            <div class="alert alert-danger">
                {% if numberOfLineQuery == 0 %}
                    Aucune données ne correspondent aux filtres sélectionnés.
                {% else %}
                    Les filtres sélectionnés représentent {{ numberOfLineQuery }} résultats.
                    Ce module est limité à l'affichage de {{ numberOfLineMax }}.
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
