<template id="checkboxTpl">
    <label class="checkbox-label">
        <input type="checkbox">
        <span class="checkbox-custom rectangular"></span>
    </label>
</template>
<template id="loader">
    <div class="row">
        <div class="col text-center">
            <i class="fas fa-spin fa-spinner fa-4x my-3 text-primaru"></i>
        </div>
    </div>
</template>

<template id="icon">
    <i class="fa fa-[[data]] text-primary"></i>
</template>